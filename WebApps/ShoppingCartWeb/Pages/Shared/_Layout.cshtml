<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(ViewData["Title"] ?? "ShoppingCartWeb")
    </title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ShoppingCartWeb.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- ========================= NAVBAR ========================= -->

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-page="/Index">

                    <i class="fa-solid fa-cart-shopping me-2"></i>
                    ShoppingCartWeb

                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link active"
                               asp-area=""
                               asp-page="/Index">

                                <i class="fa-solid fa-house me-1"></i>
                                Home

                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-warning text-dark fw-semibold" asp-page="/Cart">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                Cart
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-warning text-dark fw-semibold" asp-page="/ProductList">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                Product
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-warning text-dark fw-semibold" asp-page="/Order">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                Order
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-warning text-dark fw-semibold" asp-page="/Contact">
                                <i class="fa-solid fa-cart-plus me-1"></i>
                                Contact
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Privacy">
                                <i class="fa-solid fa-shield-halved me-1"></i>
                                Privacy
                            </a>
                        </li>



                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- ========================= MAIN CONTENT ========================= -->

    <main class="container py-4">

        @RenderBody()

    </main>

    <!-- ========================= FOOTER ========================= -->

    <footer class="border-top bg-white mt-5 py-4 shadow-sm">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6 text-center text-md-start">

                    <span class="text-muted">
                        © 2026 ShoppingCartWeb
                    </span>

                </div>

                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">

                    <a asp-area=""
                       asp-page="/Privacy"
                       class="text-decoration-none text-primary">

                        Privacy Policy

                    </a>

                </div>

            </div>

        </div>

    </footer>

    <!-- ========================= SCRIPTS ========================= -->
    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>