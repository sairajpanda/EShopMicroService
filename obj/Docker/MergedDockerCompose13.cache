name: dockercompose12355641691051504970
services:
  catalogapi:
    build:
      context: C:\Users\debra\source\repos\EShopMicroService
      dockerfile: Catalog.API/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__DefaultConnection: Server=sqlserver;Database=CatalogDb;User Id=sa;Password=StrongP@ssw0rd!;TrustServerCertificate=True;
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "5001"
        protocol: tcp
  sqlserver:
    container_name: sqlserver
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: StrongP@ssw0rd!
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      backend: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: volume
        source: sql_data
        target: /var/opt/mssql
        volume: {}
networks:
  backend:
    name: dockercompose12355641691051504970_backend
  default:
    name: dockercompose12355641691051504970_default
volumes:
  sql_data:
    name: dockercompose12355641691051504970_sql_data