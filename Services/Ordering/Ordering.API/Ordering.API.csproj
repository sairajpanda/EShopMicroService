    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b87be633-af70-4e85-9629-3354b2b31c03</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
